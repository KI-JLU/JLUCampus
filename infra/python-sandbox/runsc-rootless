#!/usr/bin/env bash
# gVisor for rootless Podman, where Docker cannot be given the `runsc` runtime (that needs root):
# PYTHON_SANDBOX_DOCKER=podman and PYTHON_SANDBOX_RUNTIME=<absolute path of this file>.
#
# Podman calls this as its OCI runtime; everything is handed to gVisor's runsc. Without root runsc
# cannot set up the container's cgroup, so a container is created in a systemd user scope holding
# the limits of `docker run` (memory, processes, CPU time), and runsc is shown a cgroup with them
# to read. The container is made to look as it does under Docker with runsc, as HAWKI runs it:
# - gVisor's CPUs, memory (/proc/meminfo, sysconf) and cgroup files follow the limits.
# - Docker's files and mounts instead of Podman's: no /run/.containerenv, /run/secrets or
#   `container` variable, no tmpfs on /run and /var/tmp, /tmp and /dev/shm as Docker mounts them,
#   bind mounts without nosuid/noexec, Docker's /etc/hosts and /etc/resolv.conf of a container
#   without network and its loopback interface, Docker's limits of open files and processes, and
#   the mounts in Docker's order.
# SELinux labels are dropped: runsc does not support them.
#
# runsc: RUNSC, else infra/python-sandbox/.gvisor/runsc (`bun run sandbox:gvisor`), else PATH.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
runsc="${RUNSC:-$here/.gvisor/runsc}"
[[ -x "$runsc" ]] || runsc="$(command -v runsc)"

args=("$@")
command=""
bundle="$PWD"
pid_file=""
id=""
for ((i = 0; i < ${#args[@]}; i++)); do
  arg="${args[i]}"
  if [[ -z "$command" ]]; then
    case "$arg" in
      --root | --log | --log-format) i=$((i + 1)) ;;
      -*) ;;
      *) command="$arg" ;;
    esac
  else
    case "$arg" in
      --bundle | -b)
        bundle="${args[i + 1]}"
        i=$((i + 1))
        ;;
      --bundle=*) bundle="${arg#--bundle=}" ;;
      --pid-file)
        pid_file="${args[i + 1]}"
        i=$((i + 1))
        ;;
      --pid-file=*) pid_file="${arg#--pid-file=}" ;;
      --console-socket) i=$((i + 1)) ;;
      -*) ;;
      *) id="$arg" ;;
    esac
  fi
done

if [[ "$command" != create ]]; then
  exec "$runsc" --ignore-cgroups "$@"
fi

config="$bundle/config.json"
read -r memory pids quota period < <(jq -r '[
  .linux.resources.memory.limit // "infinity",
  .linux.resources.pids.limit // "infinity",
  .linux.resources.cpu.quota // 0,
  .linux.resources.cpu.period // 100000
] | @tsv' "$config")

# Docker's /etc/hosts and /etc/resolv.conf for a container without network. The name servers are
# the host's, from systemd-resolved's list when the host uses its stub, as Docker takes them.
printf '127.0.0.1\tlocalhost\n' > "$bundle/docker-hosts"
host_resolv=/etc/resolv.conf
if grep -qE '^nameserver 127\.0\.0\.53$' /etc/resolv.conf && [[ -f /run/systemd/resolve/resolv.conf ]]; then
  host_resolv=/run/systemd/resolve/resolv.conf
fi
{
  printf '# Generated by Docker Engine.\n'
  printf '# This file can be edited; Docker Engine will not make further changes once it\n'
  printf '# has been modified.\n\n'
  grep -E '^nameserver ' "$host_resolv" | grep -vE ' (127\.|::1$)' || true
  grep -E '^(search|options) ' "$host_resolv" || true
  printf "\n# Based on host file: '%s' (legacy)\n# Overrides: []\n" "$host_resolv"
} > "$bundle/docker-resolv.conf"

# HAWKI's code directory belongs to its PHP user, 100:101, whom the image does not know. Here the
# server's own user would show as root: a copy owned by 100:101 (Podman's user namespace, in which
# this runs, maps them) is mounted instead. It goes into the container's run directory, beside the
# PID file, on a tmpfs as the original, and goes with it.
work="$(jq -r '[.mounts[] | select(.destination == "/work" and .type == "bind") | .source][0] // ""' "$config")"
if [[ -n "$work" ]]; then
  work_copy="$(dirname "${pid_file:-$bundle/pidfile}")/work"
  rm -rf "$work_copy"
  cp -a "$work" "$work_copy"
  chown -R 100:101 "$work_copy"
  work="$work_copy"
fi

jq --arg hosts "$bundle/docker-hosts" --arg resolv "$bundle/docker-resolv.conf" --arg id "$id" \
  --arg work "$work" '
  def unrestricted: map(select(. != "nosuid" and . != "noexec" and . != "nodev"));
  del(.process.selinuxLabel, .linux.mountLabel)
  | .process.env |= map(select(startswith("container=") | not))
  | .process.rlimits = [{type: "RLIMIT_NOFILE", soft: 524287, hard: 524288}]
  | .linux.cgroupsPath = "/runsc-\($id)"
  | .linux.namespaces |= map(
      if .type == "network" and (.path // "") == "" then .path = "/proc/self/ns/net" else . end)
  | .mounts |= (
      map(select(.destination as $d
        | ["/run", "/var/tmp", "/run/.containerenv", "/run/secrets"] | index($d) | not))
      | map(
          if .destination == "/tmp" then .options = (["noexec"] + .options | unique)
          elif .destination == "/dev/shm" then
            {destination: "/dev/shm", type: "tmpfs", source: "shm",
             options: ["nosuid", "noexec", "nodev", "mode=1777", "size=65536k"]}
          elif .destination == "/etc/hosts" then .source = $hosts | .options |= unrestricted
          elif .destination == "/work" and .type == "bind" then .source = $work | .options |= unrestricted
          elif .type == "bind" then .options |= unrestricted
          else . end)
      + [{destination: "/etc/resolv.conf", type: "bind", source: $resolv,
          options: ["rbind", "rprivate", "ro"]}]
      # In Docker'"'"'s order: runsc mounts them by the length of their path, in this order when equal.
      | sort_by(.destination as $d
          | ["/proc", "/dev", "/dev/pts", "/sys", "/sys/fs/cgroup", "/dev/mqueue", "/dev/shm"]
          | index($d) // (["/etc/resolv.conf", "/etc/hostname", "/etc/hosts"] | index($d) | values + 20)
          // 10)
    )
' "$config" > "$config.tmp"
mv "$config.tmp" "$config"

properties=(-p "MemoryMax=$memory" -p MemorySwapMax=0 -p "TasksMax=$pids")
((quota > 0)) && properties+=(-p "CPUQuota=$((quota * 100 / period))%")

# runsc runs in namespaces of its own. In the mount namespace /sys/fs/cgroup shows it the
# container's cgroup with the limits of `docker run`, from which it gives the container as many
# CPUs as the CPU limit rounded up (at least two), the memory limit as the machine's memory and
# the CPU limit in its cgroup files; the scope enforces them. The network namespace, which the
# container joins, has only its IPv4 loopback up, as Docker's for --network=none, which gVisor
# gives the container too.
cgroup="/sys/fs/cgroup"
[[ "$memory" =~ ^[0-9]+$ ]] || memory=9223372036854771712
((quota > 0)) || quota=-1
setup="
  echo 1 > /proc/sys/net/ipv6/conf/lo/disable_ipv6 && ip link set lo up
  mount -t tmpfs -o mode=755 cgroup $cgroup
  for controller in blkio cpu cpuacct cpuset devices freezer hugetlb memory net_cls net_prio perf_event pids rdma systemd; do
    mkdir -p $cgroup/\$controller/runsc-$id && : > $cgroup/\$controller/runsc-$id/cgroup.procs
  done
  echo $quota > $cgroup/cpu/runsc-$id/cpu.cfs_quota_us
  echo $period > $cgroup/cpu/runsc-$id/cpu.cfs_period_us
  cat /sys/devices/system/cpu/online > $cgroup/cpuset/runsc-$id/cpuset.cpus
  echo $memory > $cgroup/memory/runsc-$id/memory.limit_in_bytes
"

# runsc is to use the cgroup it is shown, not a systemd unit as Podman asks it to.
create=()
for arg in "$@"; do
  [[ "$arg" == --systemd-cgroup* ]] || create+=("$arg")
done
exec systemd-run --user --scope --quiet --collect --unit="runsc-$id" "${properties[@]}" -- \
  unshare --mount --net --propagation private -- sh -ec "$setup"' exec "$@"' sh \
  "$runsc" "${create[@]}"
