# ---- Server (apps/server) ----
PORT=3000
DATABASE_URL=postgres://justcampus:justcampus@127.0.0.1:5433/justcampus
# Public origin of the API. Better-Auth builds its OAuth callback from it.
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Comma-separated origins allowed to call the API with cookies.
# `app://-` is the Electron renderer's origin.
CORS_ORIGINS=http://localhost:5173,app://-
# Keycloak
KEYCLOAK_ISSUER=http://localhost:8080/realms/justcampus
KEYCLOAK_CLIENT_ID=justcampus
KEYCLOAK_CLIENT_SECRET=justcampus-dev-secret
# Realm role that grants access to the admin panel.
KEYCLOAK_ADMIN_ROLE=admin
# Allow the feed proxy to reach private and loopback hosts. Development only.
FEED_ALLOW_PRIVATE_HOSTS=false
# Where Keycloak sends the browser after sign-out. Defaults to the first CORS
# origin; set it to the API origin when the API serves the web app itself.
# WEB_ORIGIN=http://localhost:5173
# Set to a directory to serve the built web app from the server (production).
# SERVE_WEB_DIR=../web/dist

# ---- Web (apps/web) ----
# Where the browser reaches the API in development. Empty = same origin.
VITE_API_URL=http://localhost:3000

# ---- Desktop (apps/desktop) ----
# API origin baked into the desktop build; can be overridden at runtime with
# the JUSTCAMPUS_API_URL environment variable.
DESKTOP_API_URL=http://localhost:3000
